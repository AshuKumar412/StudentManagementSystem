# Database Configuration (PostgreSQL on Render / Supabase / Neon / Aiven)
DB_URL=jdbc:postgresql://<host>:<port>/<database_name>
DB_USERNAME=<username>
DB_PASSWORD=<password>

# Server Port (Render sets this dynamically, default is 8080)
PORT=8080

# CORS Allowed Origins (Comma-separated URLs, include your Vercel URL without trailing slash)
CORS_ALLOWED_ORIGINS=https://student-management-system-ashu-kumar1.vercel.app,http://localhost:5173

# Application Public Base URL (optional - used for absolute image URLs, e.g. https://<your-backend>.onrender.com)
APP_BASE_URL=https://<your-backend>.onrender.com

# Security / JWT (Provide a 64+ char hex or random string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
